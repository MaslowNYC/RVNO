# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored; never put real keys in THIS file — it is committed.

# Supabase (RVNO project)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# Google Maps JavaScript API key (crew map + album photo locations)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your_google_maps_api_key_here
